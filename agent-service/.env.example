# Copy to .env (gitignored) and fill in. Never commit real values.
# Switch providers with LLM_PROVIDER=openai|minimax (default: minimax).
# One model per provider — used for both extraction and explanation.

LLM_PROVIDER=minimax

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# --- MiniMax (when LLM_PROVIDER=minimax) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
